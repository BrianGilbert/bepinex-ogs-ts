<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ogs_smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OgsTelemetry/*.cs" Link="OgsTelemetry/%(Filename)%(Extension)" />
    <Compile Include="../Heading/*.cs" Link="Heading/%(Filename)%(Extension)" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
